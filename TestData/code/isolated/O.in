&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  prefix = 'O_atom_isolated'
  pseudo_dir = './'
  outdir = './tmp/'
/
&SYSTEM
  ibrav = 1
  celldm(1) = 25.0       ! Stessa identica scatola usata per il Tantalo
  nat = 1
  ntyp = 1
  ecutwfc = 50.0         ! Deve essere identico al calcolo del Ta
  ecutrho = 400.0        ! Deve essere identico al calcolo del Ta
  nspin = 2              ! L'ossigeno molecolare/atomico è un tripletto di spin di default
  starting_magnetization(1) = 0.5
  tot_magnetization = 2
/
&ELECTRONS
  conv_thr = 1.0d-5
  mixing_beta = 0.6
/
ATOMIC_SPECIES
  O  16.00000  O.upf
ATOMIC_POSITIONS (crystal)
  O  0.5  0.5  0.5      ! Al centro della supercella
K_POINTS (gamma)
