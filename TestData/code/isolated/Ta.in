&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  prefix = 'Ta_atom_isolated'
  pseudo_dir = './'
  outdir = './tmp/'
/
&SYSTEM
  ibrav = 1
  celldm(1) = 25.0       ! Scatola cubica di 25 Bohr (circa 13.2 Angstrom)
  nat = 1
  ntyp = 1
  ecutwfc = 50.0         ! NOTA: Imposta lo stesso valore usato nella tua MD originale
  ecutrho = 400.0        ! NOTA: Imposta lo stesso valore usato nella tua MD originale
  nspin = 2              ! Attiva il calcolo con polarizzazione di spin (collineare)
  starting_magnetization(1) = 0.5
  tot_magnetization = 3
/
&ELECTRONS
  conv_thr = 1.0d-5
  mixing_beta = 0.6
/
ATOMIC_SPECIES
  Ta  180.95000  Ta.upf
ATOMIC_POSITIONS (crystal)
  Ta  0.5  0.5  0.5     ! Posizionato esattamente al centro della supercella
K_POINTS (gamma)        ! Per un atomo isolato basta il punto Gamma
